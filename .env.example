# PostgreSQL connection URL used by the FastAPI backend.
DATABASE_URL=postgresql://example_user:example_password@postgres:5432/example_db

# Redis connection URL used for caching and rate limiting.
REDIS_URL=redis://redis:6379/0

# Triage implementation to use: llm, ollama, rules, or simulated.
#   llm       - external Groq API. Requires LLM_API_KEY below.
#   ollama    - local Ollama model. No API key, no outbound internet needed.
#   rules     - deterministic keyword matching, no model.
#   simulated - fixed canned responses, for tests and demos.
TRIAGE_PROVIDER=simulated

# Placeholder API key for the selected external LLM provider.
# Only read when TRIAGE_PROVIDER=llm. Leave unset for ollama/rules/simulated.
LLM_API_KEY=replace_with_fake_llm_key

# Where the Ollama server lives, and which model to use.
# Only read when TRIAGE_PROVIDER=ollama. The default host is the compose
# service name, reachable because both sit on the `internal` network.
#
# The model must be pulled once before first use, otherwise every triage call
# fails and silently falls back to `rules:fallback`:
#
#   docker compose up -d ollama
#   docker compose exec ollama ollama pull llama3.2:1b
#
# Any small CPU-friendly model works; llama3.2:1b is ~1.3GB. Check what is
# present with `docker compose exec ollama ollama list`.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:1b

# Maximum number of requests allowed per client per minute.
RATE_LIMIT_PER_MINUTE=60

# Frontend origin allowed by the backend CORS policy.
CORS_ORIGIN=http://localhost:5173

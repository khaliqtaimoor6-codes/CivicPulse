# PostgreSQL connection URL used by the FastAPI backend.
DATABASE_URL=postgresql://example_user:example_password@postgres:5432/example_db

# Redis connection URL used for caching and rate limiting.
REDIS_URL=redis://redis:6379/0

# Triage implementation to use: llm, ollama, rules, or simulated.
#   llm       - external OpenAI-compatible API. Requires LLM_API_KEY below.
#               Defaults to Groq; set LLM_BASE_URL to use another host.
#   ollama    - local Ollama model. No API key, no outbound internet needed.
#   rules     - deterministic keyword matching, no model. Confidence 0.6.
#   simulated - the same keyword rules as `rules`, reported under the provider
#               name `simulated` with confidence 0.5. It is a labelled stand-in
#               for a model, not a set of canned answers: the category and
#               priority come from backend/app/providers/triage/rules.py, so
#               "simulated" results must be described as rule-based, and a demo
#               using it is not evidence of a working model.
TRIAGE_PROVIDER=simulated

# Placeholder API key for the selected external LLM provider.
# Only read when TRIAGE_PROVIDER=llm. Leave unset for ollama/rules/simulated.
LLM_API_KEY=replace_with_fake_llm_key

# ---------------------------------------------------------------------------
# The `llm` provider uses one client against any OpenAI-compatible
# /chat/completions endpoint, so switching host is configuration only.
# ---------------------------------------------------------------------------

# Endpoint to call. Unset means Groq's own endpoint, which is the default this
# project ships with. For OpenRouter, set the value below. Any host speaking the
# OpenAI chat-completions shape works; the provider is named in `triaged_by` by
# its host, so the UI and recorded evidence show who actually answered.
# LLM_BASE_URL=https://openrouter.ai/api/v1

# Model id sent to that endpoint. The default below is a Groq model; an
# OpenRouter free model must use a `:free` suffix, e.g.
# `meta-llama/llama-3.3-70b-instruct:free`. Free catalogues churn often, so
# check https://openrouter.ai/models for what is available before the demo.
# LLM_MODEL=replace_with_a_free_model_id

# Sends response_format={"type": "json_object"} to enforce JSON output. Groq
# requires it. Some OpenRouter free models reject it with a 400, so if every
# call fails, set this to false -- the prompt already asks for bare JSON and
# the backend validates the schema itself either way.
# LLM_JSON_MODE=true

# Where the Ollama server lives, and which model to use.
# Only read when TRIAGE_PROVIDER=ollama. The default host is the compose
# service name, reachable because both sit on the `internal` network.
#
# Ollama is an optional service behind a compose profile, so it is not part of
# the default `docker compose up`. Opt in explicitly when you want a local
# model:
#
#   docker compose --profile ollama up -d ollama
#   docker compose --profile ollama exec ollama ollama pull llama3.2:1b
#
# The model must be pulled once before first use, otherwise every triage call
# fails and silently falls back to `rules:fallback`. Note that the `internal`
# network has no route to the internet, so `ollama pull` must be run from a
# context that can reach a registry -- the first command above needs to be
# paired with a network that allows egress, or the image has to be pre-loaded.
#
# Any small CPU-friendly model works; llama3.2:1b is ~1.3GB. Check what is
# present with `docker compose --profile ollama exec ollama ollama list`.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:1b

# Maximum number of requests allowed per client per minute.
# This is the value the demo and the recorded evidence use. Keep it in sync
# with the runtime: compose.yaml pins 30, k8s/base/configmap.yaml pins 30, and
# compose.prod.yaml defaults to 30 when this variable is unset. Editing it here
# only changes compose.prod.yaml, which is why the value is stated explicitly
# rather than implied.
RATE_LIMIT_PER_MINUTE=30

# Frontend origin allowed by the backend CORS policy.
CORS_ORIGIN=http://localhost:5173

# Host port the frontend is published on in compose.prod.yaml, which is the
# only file that reads this variable. The dev stack (compose.yaml) hardcodes
# its own mapping and always publishes 5173, so override this only for prod.
FRONTEND_PORT=80

# ---------------------------------------------------------------------------
# compose.prod.yaml only. The dev stack (compose.yaml) hardcodes its own
# database credentials, so these are needed only when deploying the built
# images rather than building from source. They are listed here so the file is
# a complete template for both stacks.
# ---------------------------------------------------------------------------

# Database credentials for compose.prod.yaml. Change the password before any
# real deployment; compose.prod.yaml has no default for these, so a missing
# value substitutes an empty string and Postgres refuses to start.
POSTGRES_USER=civicpulse
POSTGRES_PASSWORD=replace_with_a_real_password
POSTGRES_DB=civicpulse

# Immutable tag of the images compose.prod.yaml deploys. CI deploys by image
# digest rather than tag, so this is for manual or local verification only.
# Never set this to `latest` for a real deployment: see docs/adr/0003.
IMAGE_TAG=sha-PLACEHOLDER
